<Window x:Class="SoundPooper.MVVM.Views.SoundPooperView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:SoundPooper.MVVM.ViewModels"
        xmlns:views="clr-namespace:SoundPooper.MVVM.Views"
        xmlns:userControls="clr-namespace:SoundPooper.UserControls"
        xmlns:extensions="clr-namespace:SoundPooper.MVVM.Extensions"

        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Top="{Binding WindowTopLeftY, Mode=OneWay}"
        Left="{Binding WindowTopLeftX, Mode=OneWay}"
        Cursor="Hand"
        DataContext="{Binding
            SoundPooperViewModel,
            Source={StaticResource Locator}
        }"
        d:DataContext="{d:DesignInstance Type=vm:SoundPooperViewModel, IsDesignTimeCreatable=True}"
        Title="SoundPooperView"
        Height="{Binding ContainerHeight}"
        Width="{Binding ContainerWidth}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseMove">
            <i:InvokeCommandAction Command="{Binding MouseMoveCommand}"
                                   PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ItemsControl
            Grid.Column="0"
            Style="{StaticResource SplitedItemsPanelStyle}"
            ItemsSource="{Binding SoundListLeftPart}">
        </ItemsControl>
        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    VerticalAlignment="Top">
            <Button Style="{StaticResource RoundedButtonStyle}"
                    DataContext="{Binding StopActionButton}"
                    Content="{Binding Title}"
                    Width="100"
                    Height="100"
                    extensions:ButtonExtensions.CornerRadius="50"
                    Background="Red">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseEnter">
                        <i:InvokeCommandAction
                            Command="{Binding MouseEnterCommand }"
                            PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    DataContext="{Binding RepeatActionButton}"
                    Content="{Binding Title}"
                    Width="100"
                    Height="100"
                    extensions:ButtonExtensions.CornerRadius="50"
                    Background="Blue">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseEnter">
                        <i:InvokeCommandAction
                            Command="{Binding MouseEnterCommand }"
                            PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    DataContext="{Binding CancelActionButton}"
                    Width="100"
                    Height="100"
                    extensions:ButtonExtensions.CornerRadius="50"
                    Background="ForestGreen"
                    Content="{Binding Title}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseEnter">
                        <i:InvokeCommandAction
                            Command="{Binding MouseEnterCommand }"
                            PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <userControls:CircularSlider
                SmallChange="0.01"
                Value="{Binding SoundVolume, Mode=TwoWay}"
                Minimum="0.01"
                Maximum="1" />

        </StackPanel>
        <ItemsControl
            Grid.Column="2"
            Style="{StaticResource SplitedItemsPanelStyle}"
            ItemsSource="{Binding SoundListRightPart}">
        </ItemsControl>
    </Grid>
</Window>