<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:userControls="clr-namespace:SoundPooper.UserControls"
                    xmlns:vm="clr-namespace:SoundPooper.MVVM.ViewModels"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors">
    <Style TargetType="{x:Type ItemsControl}" x:Key="SplitedItemsPanelStyle">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type vm:SoundButtonViewModel}">
                    <Border Background="LightGreen"
                            Margin="10"
                            CornerRadius="20, 40, 10, 30" BorderThickness="2"
                            BorderBrush="Black">
                        <DockPanel
                            Margin="5"
                            Height="{Binding Height}"
                            Width="{Binding Width}">
                            <TextBlock DockPanel.Dock="Bottom"
                                       Text="{Binding Title}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Image Stretch="Uniform" />
                        </DockPanel>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseEnter">
                                <b:InvokeCommandAction
                                    Command="{Binding MouseEnterCommand }"
                                    PassEventArgsToCommand="True" />

                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <EventTrigger.Actions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ThicknessAnimation Storyboard.TargetProperty="BorderThickness"
                                                                        Duration="0:0:0.1"
                                                                        To="5" AutoReverse="False" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger.Actions>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <EventTrigger.Actions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ThicknessAnimation Storyboard.TargetProperty="BorderThickness"
                                                                        Duration="0:0:0.1"
                                                                        To="1" AutoReverse="False" />   
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger.Actions>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>